<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/"
version="1"
bind-to-class="main.vistas.menuAdministrador.formGestionAreas">

<grid id="pnlPrincipal" binding="pnlPrincipal" layout-manager="BorderLayout" hgap="10" vgap="10">
<border type="none"/>

<!-- ===== TÍTULO ===== -->
<grid id="pnlTitulo" layout-manager="FlowLayout">
<constraints border-constraint="North"/>
<border type="none"/>
<component id="labelTitulo" class="javax.swing.JLabel">
<properties>
<text value="Gestión de Áreas"/>
<font size="18" style="1"/>
</properties>
</component>
</grid>

<!-- ===== PANEL CENTRAL ===== -->
<grid id="pnlDatos" layout-manager="GridLayoutManager" row-count="2" column-count="1">
<constraints border-constraint="Center"/>
<border type="none"/>

<!-- TABLA -->
<scrollpane>
<constraints>
<grid row="0" column="0" fill="both" vsize-policy="can_shrink|can_grow"
hsize-policy="can_shrink|can_grow"/>
</constraints>
<component id="tablaAreas" class="javax.swing.JTable" binding="tablaAreas"/>
</scrollpane>

<!-- FORMULARIO -->
<grid layout-manager="GridLayoutManager" row-count="2" column-count="3">
<constraints>
<grid row="1" column="0" fill="both"/>
</constraints>
<border type="none"/>

<component class="javax.swing.JLabel">
<constraints>
<grid row="0" column="0"/>
</constraints>
<properties>
<text value="Nombre del Área:"/>
</properties>
</component>

<component class="javax.swing.JTextField" binding="txtNombre">
<constraints>
<grid row="0" column="1" fill="horizontal"/>
</constraints>
</component>

<component class="javax.swing.JButton" binding="btnGuardar">
<constraints>
<grid row="0" column="2"/>
</constraints>
<properties>
<text value="Guardar"/>
</properties>
</component>

<component class="javax.swing.JButton" binding="btnEliminar">
<constraints>
<grid row="1" column="1"/>
</constraints>
<properties>
<text value="Eliminar"/>
</properties>
</component>

<component class="javax.swing.JButton" binding="btnRefrescar">
<constraints>
<grid row="1" column="2"/>
</constraints>
<properties>
<text value="Refrescar"/>
</properties>
</component>
</grid>
</grid>

</grid>
</form>
