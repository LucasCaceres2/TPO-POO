<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="main.vistas.menuAlumno.formCursosDisponiblesAlumno">
  <grid id="27dc6" binding="pnlPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="20" left="20" bottom="20" right="20"/>
    </border>
    <children>
      <grid id="4bbb4" binding="pnlTitulo" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <preferredSize width="121" height="75"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="e81ff" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Cursos Disponibles"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="37536" binding="pnlDatos" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="5ccb3">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="empty">
              <size top="0" left="0" bottom="15" right="0"/>
            </border>
            <children>
              <component id="5cd2c" class="javax.swing.JTable" binding="tablaCursos">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
          <component id="d1510" class="javax.swing.JButton" binding="inscribirmeButton" default-binding="true">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <hideActionText value="false"/>
              <inheritsPopupMenu value="false"/>
              <text value="Inscribirme"/>
            </properties>
          </component>
          <component id="87dca" class="javax.swing.JButton" binding="cerrarButton" default-binding="true">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value="Cerrar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
